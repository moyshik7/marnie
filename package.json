{
    "name": "marnie",
    "version": "0.1.3",
    "description": "A self-hosted AI workspace like Odysseus but made in nodejs with more (and in some cases less) features according to my own preference",
    "main": "src/main.js",
    "scripts": {
        "start": "npm run build && node src/main.js",
        "dev": "nodemon src/main.js",
        "frontend:dev": "cd frontend && npm run dev",
        "frontend:build": "cd frontend && npm run build",
        "build": "npm run frontend:build"
    },
    "dependencies": {
        "axios": "^1.7.9",
        "better-sqlite3": "^13.0.3",
        "dotenv": "^18.0.5",
        "express": "^4.21.2",
        "node-cron": "^3.0.3",
        "uuid": "^11.0.3"
    },
    "devDependencies": {
        "nodemon": "^3.1.7"
    },
    "keywords": [
        "ai",
        "workspace",
        "ollama",
        "self-hosted",
        "agents"
    ],
    "license": "MIT",
    "allowScripts": {
        "better-sqlite3@11.10.0": true
    }
}
