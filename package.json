{
    "name": "marnie",
    "version": "0.5.1",
    "description": "The local AI workspace with built-in tools. Run deep research, scrape websites, interact with local files, and trigger webhooks with zero extra microservices required.",
    "main": "src/main.js",
    "scripts": {
        "start": "npm run build && node src/main.js",
        "nobuild": "node src/main.js",
        "dev": "nodemon src/main.js",
        "frontend:dev": "cd frontend && npm run dev",
        "frontend:build": "cd frontend && npm run build",
        "build": "npm run frontend:build"
    },
    "dependencies": {
        "axios": "^1.7.9",
        "better-sqlite3": "^13.0.3",
        "cheerio": "^1.2.0",
        "dotenv": "^18.0.5",
        "express": "^4.21.2",
        "node-cron": "^4.6.0",
        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "nodemon": "^3.1.7"
    },
    "keywords": [
        "ai",
        "workspace",
        "ollama",
        "self-hosted",
        "agents"
    ],
    "license": "MIT",
    "allowScripts": {
        "better-sqlite3@13.0.3": true
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moyshik7/marnie.git"
    }
}
